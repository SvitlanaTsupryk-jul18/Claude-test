{{!< default}}{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}


{{#contentFor "styles"}}
    <link rel="stylesheet" type="text/css" href="{{asset "public/cards.min.css" has_min="true"}}">
{{/contentFor}}

<main class="gh-main gh-outer">
    <div class="gh-inner">
        {{#post}}

        {{> "components/toc"}}
        {{> "breadcrumb"}}

        <article class="post {{post_class}}">
            <section class="post-hero">
                {{#if feature_image}}
                <figure class="post-hero-img">
                    <img srcset="{{img_url feature_image size="s" format="webp"}} 320w,
                        {{img_url feature_image size="m" format="webp"}} 600w,
                        {{img_url feature_image size="l" format="webp"}} 960w,
                        {{img_url feature_image size="xl" format="webp"}} 1296w"
                        sizes="(max-width: 767px) calc(100vw - 32px), 636px" src="{{img_url feature_image size="m"}}"
                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                        fetchpriority="high" width="616" height="450">
                </figure>
                {{/if}}

                <div class="post-hero-info">
                    <div>
                        <div class="post-hero-tags">
                            {{#if primary_tag}}
                            <a class="post-tag" href="{{primary_tag.url}}">{{primary_tag.name}}</a>
                            {{#foreach tags visibility="internal"}}
                            <a class="post-tag post-tag--internal"
                                href="{{../primary_tag.url}}?filter={{slug}}"><span>{{name}}</span></a>
                            {{/foreach}}
                            {{/if}}
                        </div>
                        <h1 class="post-hero-title">{{title}}</h1>
                    </div>
                    <div>
                        <div class="post-hero-meta">
                            {{> "components/share-socials"}}
                            <div class="post-card-meta">
                                <span class="post-card-author">{{#foreach authors}}
                                    {{#if @first}}<a href="{{url}}">{{name}}</a>
                                    {{else}}, <a href="{{url}}">{{name}}</a>
                                    {{/if}}{{/foreach}}</span>
                                {{> components/date-time updated=true}}
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <div class="post-content-wrapper">
                <aside class="post-sidebar"></aside>
                <section class="post-content">
                    {{content}}
                    <div class="post-author">
                        <p class="title-small">Автор</p>
                        {{#primary_author}}
                        {{> "components/author-card"}}
                        {{/primary_author}}
                    </div>
                    <div class="post-share">
                        <p class="h3">Сподобалася стаття? Поділіться нею з друзями!</p>
                        {{> "components/share-socials"}}
                    </div>
                </section>
            </div>
        </article>
        {{/post}}

        {{#get "posts" include="authors,tags" filter="tags:[{{post.tags}}]+id:-{{post.id}}+visibility:public"
        fields="title,url,slug,published_at,html,primary_tag" limit="4" as |recomend| }}
        {{#if recomend}}
        {{> "components/short-posts" posts=recomend title="Рекомендовані статті"}}
        {{/if}}
        {{/get}}
    </div>
</main>

{{> "cta"}}

{{#post}}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "publisher": {
        "@type": "Organization",
        "name": "{{@site.title}}",
        "url": "{{@site.url}}/",
        "logo": {
            "@type": "ImageObject",
            "url": "{{@site.logo}}",
            "width": 100,
            "height": 16
        }
    },
    "author": {
        "@type": "Person",
        "name": "{{primary_author.name}}",
        {{#if primary_author.profile_image}}
        "image": {
            "@type": "ImageObject",
            "url": "{{primary_author.profile_image}}"
        },
        {{/if}}
        "url": "{{primary_author.url}}",
        "sameAs": [
            {{#if primary_author.website}}"{{primary_author.website}}"{{/if}}
        ]
    },
    "headline": "{{meta_title}}",
    "url": "{{url absolute="true"}}",
    "datePublished": "{{date format="YYYY-MM-DDTHH:mm:ss.SSSZ"}}",
    "dateModified": "{{date updated_at format="YYYY-MM-DDTHH:mm:ss.SSSZ"}}",
    {{#if feature_image}}
    "image": {
        "@type": "ImageObject",
        "url": "{{img_url feature_image absolute="true"}}",
        "width": 616,
        "height": 450
    },
    {{/if}}
    "description": "{{meta_description}}",
    "mainEntityOfPage": "{{url absolute="true"}}"
}
</script>
{{/post}}
