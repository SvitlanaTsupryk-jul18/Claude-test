<nav>
<ul class="breadcrumb">
    <li class="breadcrumb-item"><a href="{{@site.url}}">Головна</a></li>
    
    {{#is "post"}}
        {{#if primary_tag}}
            <li class="breadcrumb-item"><a href="{{primary_tag.url}}">{{primary_tag.name}}</a></li>
        {{/if}}
        <li class="breadcrumb-item-current">{{title}}</li>
    {{/is}}

    {{#is "tag"}}
        <li class="breadcrumb-item-current">{{name}}</li>
    {{/is}}

    {{#is "author"}}
        <li class="breadcrumb-item-current">{{name}}</li>
    {{/is}}
</ul>
</nav>
{{#is "post"}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Головна",
      "item": "https://checkbox.ua/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Усі статті",
      "item": "{{@site.url}}/"
    }
    {{#if primary_tag}}
    ,{
      "@type": "ListItem",
      "position": 3,
      "name": "{{primary_tag.name}}",
      "item": "{{primary_tag.url}}"
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": "{{meta_title}}",
      "item": "{{url absolute="true"}}"
    }
    {{else}}
    ,{
      "@type": "ListItem",
      "position": 3,
      "name": "{{meta_title}}",
      "item": "{{url absolute="true"}}"
    }
    {{/if}}
  ]
}
</script>
{{/is}}

