{{!< default}}

{{#contentFor "styles"}}
    <link rel="stylesheet" type="text/css" href="{{asset "public/cards.min.css" has_min="true"}}">
{{/contentFor}}

<main class="gh-main gh-outer">
    <div class="gh-inner">
        {{#post}}

        {{> "breadcrumb"}}

        <article class="post post-video {{post_class}}">
            <section class="post-hero">
                <h1>{{title}}</h1>
                {{#if feature_image}}
                <div class="video-wrapper" id="videoWrapper">
                <figure class="post-hero-img">
                    <img srcset="{{img_url feature_image size="s" format="webp"}} 320w,
                        {{img_url feature_image size="m" format="webp"}} 600w,
                        {{img_url feature_image size="l" format="webp"}} 960w,
                        {{img_url feature_image size="xl" format="webp"}} 1296w,
                        {{img_url feature_image size="xxl"}} 2000w" 
                        sizes="(min-width: 1296px) 1296px, (max-width: 767px) 240px, calc(100vw - 32px)"
                        src="{{img_url feature_image size="xl"}}"
                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                        fetchpriority="high"
                        decoding="async"
                        width="1296" 
                        height="729">
                </figure>
                    <button class="play-button" id="playBtn" aria-label="Play video">
                        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path
                                d="M17.3 27.5L27.05 21.25C27.5166 20.95 27.75 20.5333 27.75 20C27.75 19.4667 27.5166 19.05 27.05 18.75L17.3 12.5C16.8 12.1667 16.2913 12.1413 15.774 12.424C15.2567 12.7067 14.9987 13.1487 15 13.75V26.25C15 26.85 15.2587 27.292 15.776 27.576C16.2933 27.86 16.8013 27.8347 17.3 27.5ZM20 40C17.2333 40 14.6333 39.4747 12.2 38.424C9.76666 37.3733 7.65 35.9487 5.85 34.15C4.05 32.3513 2.62533 30.2347 1.576 27.8C0.526669 25.3653 0.00133586 22.7653 2.53164e-06 20C-0.0013308 17.2347 0.524002 14.6347 1.576 12.2C2.628 9.76533 4.05267 7.64867 5.85 5.85C7.64733 4.05133 9.764 2.62667 12.2 1.576C14.636 0.525333 17.236 0 20 0C22.764 0 25.364 0.525333 27.8 1.576C30.236 2.62667 32.3526 4.05133 34.15 5.85C35.9473 7.64867 37.3726 9.76533 38.426 12.2C39.4793 14.6347 40.004 17.2347 40 20C39.996 22.7653 39.4706 25.3653 38.424 27.8C37.3773 30.2347 35.9526 32.3513 34.15 34.15C32.3473 35.9487 30.2306 37.374 27.8 38.426C25.3693 39.478 22.7693 40.0027 20 40Z"
                                fill="white" />
                        </svg>
                    </button>
                </div>
                {{/if}}
                {{! Hidden YouTube iframe, revealed on play click }}
                <div class="youtube-embed" id="youtubeEmbed" style="display:none;"> </div>
                <div class="post-hero-info">
                    <div>
                        <p class="post-hero-excerpt">{{excerpt}}</p>
                        <p class="post-card-meta"> {{> components/date-time }} </p>
                    </div>
                    <div class="post-hero-social">
                        <div class="post-hero-tags">
                            {{#if primary_tag}}
                            <a class="post-tag" href="{{primary_tag.url}}">{{primary_tag.name}}</a>
                            {{#foreach tags visibility="internal"}}
                            <a class="post-tag post-tag--internal"
                                href="{{../primary_tag.url}}?filter={{slug}}"><span>{{name}}</span></a>
                            {{/foreach}}
                            {{/if}}
                        </div>

                        {{> "components/share-socials"}}
                        
                    </div>
                </div>
            </section>
            <div class="post-content-wrapper">
                <aside class="post-sidebar"></aside>
                <section class="post-content">
                    <h2 class="title-small">Транскрипція відео</h2>
                    {{content}}
                    <div class="post-share">
                        <p class="h3">Сподобалася стаття? Поділіться нею з друзями!</p>
                        {{> "components/share-socials"}}
                    </div>
                </section>
            </div>
        </article>
        {{/post}}

        {{#get "posts" filter="tag:video+id:-{{post.id}}+visibility:public" limit="3" include="tags"}}
        {{#if posts}}
        <div class="video">
            {{> "components/post-list" posts=posts title="Рекомендовані відео"}}
        </div>
        {{/if}}
        {{/get}}
    </div>
</main>

{{> "cta"}}

{{#post}}
<script type="application/ld+json" id="video-schema">
{
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": "{{meta_title}}",
    "description": "{{meta_description}}",
    "thumbnailUrl": "{{img_url feature_image size="xl"}}",
    "uploadDate": "{{date format="YYYY-MM-DDTHH:mm:ss.SSSZ"}}",
    "contentUrl": "https://www.youtube.com/watch?v=Ohm1JZv_dbM",
    "publisher": {
        "@type": "Organization",
        "name": "{{@site.title}}",
        "logo": {
            "@type": "ImageObject",
            "url": "{{@site.logo}}"
        }
    }
}
</script>
<script>
(function() {
    window.addEventListener('DOMContentLoaded', () => {
        const schemaElement = document.getElementById('video-schema');
        if (schemaElement && window.postVideoId) {
            let data = JSON.parse(schemaElement.textContent);
            data.contentUrl = `https://www.youtube.com/watch?v=${window.postVideoId}`;
            schemaElement.textContent = JSON.stringify(data);
        }
    });
})();
</script>
{{/post}}